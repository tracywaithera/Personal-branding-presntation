        </div>

        <!-- Slide 6: Content Strategy -->
        <div class="slide bg-brand-light text-brand-dark">
            <div class="max-w-6xl mx-auto px-10 w-full text-center">
                <span class="text-brand-gold font-bold tracking-widest uppercase mb-2 block">05. What to Post</span>
                <h2 class="text-4xl md:text-5xl font-serif font-bold text-brand-blue mb-12">The Simple Content Rule</h2>
                
                <div class="flex flex-col md:flex-row gap-6 justify-center items-stretch text-left">
                    <div class="flex-1 bg-white p-8 rounded-3xl shadow-lg border border-gray-100 flex flex-col">
