    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body { margin: 0; overflow: hidden; background-color: #0E2052; }
        .slide {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            opacity: 0;
            transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            pointer-events: none;
            visibility: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .slide.active {
            opacity: 1;
            pointer-events: auto;
            visibility: visible;
            transform: translateX(0) scale(1);
        }
        .slide.prev {
            transform: translateX(-100px) scale(0.98);
            opacity: 0;
        }
        .slide.next {
            transform: translateX(100px) scale(0.98);
            opacity: 0;
        }
        
        /* Grid Pattern */
        .bg-grid-pattern {
            background-image: linear-gradient(to right, rgba(198, 170, 86, 0.05) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(198, 170, 86, 0.05) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        /* Glassmorphism for notes */
        .glass-panel {
            background: rgba(251, 252, 255, 0.98);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(198, 170, 86, 0.3);
        }

        /* Scrollbar styling for speaker notes */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #C6AA56; border-radius: 4px; }
    </style>
</head>
