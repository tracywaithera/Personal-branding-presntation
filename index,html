                                <div class="w-64 h-64 border-2 border-white rounded-full -mr-20"></div>
                                <div class="w-64 h-64 border-2 border-brand-gold rounded-full mt-32 absolute"></div>
                            </div>
                            
                            <div class="relative z-10 text-center space-y-3">
                                <span class="bg-white/10 text-white px-4 py-1.5 rounded-full text-sm font-semibold border border-white/20">Your Main Skill</span>
                                <div class="text-brand-gold font-bold text-xl">+</div>
                                <span class="bg-white/10 text-white px-4 py-1.5 rounded-full text-sm font-semibold border border-white/20">Your Unique Passion</span>
                                <div class="text-brand-gold font-bold text-xl">+</div>
                                <span class="bg-brand-gold text-brand-blue px-4 py-1.5 rounded-full text-sm font-bold shadow-lg">Your Personal Story</span>
                                <div class="mt-6">
                                    <div class="text-white font-serif font-bold text-2xl tracking-wide">Category of One</div>
                                </div>
                            </div>
                        </div>
                    </div>
