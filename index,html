        <!-- Slide 3: The Architecture of You -->
        <div class="slide bg-brand-blue text-white bg-grid-pattern">
            <div class="max-w-7xl mx-auto px-10 w-full">
                <div class="text-center mb-12">
                    <span class="text-brand-gold font-bold tracking-widest uppercase mb-2 block">02. Your Foundation</span>
                    <h2 class="text-4xl md:text-5xl font-serif font-bold">Your Brand Blueprint</h2>
                    <div class="w-24 h-1.5 bg-brand-gold rounded-full mt-6 mx-auto"></div>
                </div>
                
                <div class="grid md:grid-cols-4 gap-6">
                    <div class="bg-white/5 border border-brand-gold/30 p-8 rounded-3xl backdrop-blur-sm transition-all hover:bg-white/10 hover:-translate-y-2 group">
